# Netlify HTTP Response Headers for Group ACH (https://www.achlinks.in/)
# Configured so Meta (Facebook) crawler (facebookexternalhit) and social bots are never blocked

# Global Security & Crawler Friendly Headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  # NOTE: Do NOT use X-Frame-Options: DENY as it disrupts social verification and embed widgets

# Social Sharing Preview Image & Brand Assets (Fast Cache + CORS Open)
/og-image.jpg
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: image/jpeg

/logo.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: image/png

/apple-touch-icon.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: image/png

/favicon.ico
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: image/x-icon

/favicon.svg
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: image/svg+xml

/site.webmanifest
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/robots.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=UTF-8

/sitemap.xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=UTF-8

# Static Assets Hashed by Vite
/assets/*
  Cache-Control: public, max-age=31536000, immutable
